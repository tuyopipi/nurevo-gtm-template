const injectScript = require('injectScript');
const encodeUriComponent = require('encodeUriComponent');

const siteKey = data.siteKey;
const url = 'https://nurevo.jp/tag.js?site_key=' + encodeUriComponent(siteKey);

const onSuccess = () => {
  data.gtmOnSuccess();
};

const onFailure = () => {
  data.gtmOnFailure();
};

injectScript(url, onSuccess, onFailure, 'nurevoWebmcp');


